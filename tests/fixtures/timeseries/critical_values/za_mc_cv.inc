// ---------------------------------------------------------------------------
// 编译期守护: 五锚 (spec ZA4 冻结) + 端点防截断 + 单调性 + 幻觉源钉死
// ---------------------------------------------------------------------------
static_assert(ZA_MC_C_GOLDEN.size() == 48, "MC c 48 点");
static_assert(ZA_MC_T_GOLDEN.size() == 48, "MC t 48 点");
static_assert(ZA_MC_CT_GOLDEN.size() == 48, "MC ct 48 点");
// 五锚 (索引由 za_mc_gen.py 按 pct 程序化确认)
static_assert(ZA_MC_C_GOLDEN[10].pct == 1.0 && ZA_MC_C_GOLDEN[10].cv == -5.27644,
              "ZA4 anchor: MC c 1% = -5.27644");
static_assert(ZA_MC_C_GOLDEN[12].pct == 5.0 && ZA_MC_C_GOLDEN[12].cv == -4.81067,
              "ZA4 anchor: MC c 5% = -4.81067");
static_assert(ZA_MC_C_GOLDEN[14].pct == 10.0 && ZA_MC_C_GOLDEN[14].cv == -4.56618,
              "ZA4 anchor: MC c 10% = -4.56618");
static_assert(ZA_MC_T_GOLDEN[10].pct == 1.0 && ZA_MC_T_GOLDEN[10].cv == -5.03421,
              "ZA4 anchor: MC t 1% = -5.03421");
static_assert(ZA_MC_CT_GOLDEN[10].pct == 1.0 && ZA_MC_CT_GOLDEN[10].cv == -5.57556,
              "ZA4 anchor: MC ct 1% = -5.57556");
// 幻觉源钉死: c 的 0.1% 分位 = −5.83192 (≈讹传 "−5.83"), 永非 1% 值
static_assert(ZA_MC_C_GOLDEN[1].pct == 0.1 && ZA_MC_C_GOLDEN[1].cv == -5.83192,
              "ZA4 trap: -5.83 is 0.1-percentile (c[1]), never 1%");
// 混表防呆: MC c 1% ≠ 论文表 −5.34 (za1992_cv.inc)
static_assert(ZA_MC_C_GOLDEN[10].cv != -5.34,
              "ZA4 trap: MC table must not contain paper value -5.34");
// 端点防截断
static_assert(ZA_MC_C_GOLDEN[0].pct == 0.001 && ZA_MC_C_GOLDEN[0].cv == -6.78442 &&
              ZA_MC_C_GOLDEN[47].pct == 99.9 && ZA_MC_C_GOLDEN[47].cv == -1.88932,
              "MC c endpoints");
static_assert(ZA_MC_T_GOLDEN[0].pct == 0.001 && ZA_MC_T_GOLDEN[0].cv == -83.9094 &&
              ZA_MC_T_GOLDEN[47].pct == 99.9 && ZA_MC_T_GOLDEN[47].cv == -1.67466,
              "MC t endpoints");
static_assert(ZA_MC_CT_GOLDEN[0].pct == 0.001 && ZA_MC_CT_GOLDEN[0].cv == -38.178 &&
              ZA_MC_CT_GOLDEN[47].pct == 99.9 && ZA_MC_CT_GOLDEN[47].cv == -2.28767,
              "MC ct endpoints");
// 单调性: pct 升 ⇒ cv 升 (抽查首/中/尾)
static_assert(ZA_MC_C_GOLDEN[0].cv < ZA_MC_C_GOLDEN[24].cv &&
              ZA_MC_C_GOLDEN[24].cv < ZA_MC_C_GOLDEN[47].cv, "MC c monotone");
static_assert(ZA_MC_T_GOLDEN[0].cv < ZA_MC_T_GOLDEN[24].cv &&
              ZA_MC_T_GOLDEN[24].cv < ZA_MC_T_GOLDEN[47].cv, "MC t monotone");
static_assert(ZA_MC_CT_GOLDEN[0].cv < ZA_MC_CT_GOLDEN[24].cv &&
              ZA_MC_CT_GOLDEN[24].cv < ZA_MC_CT_GOLDEN[47].cv, "MC ct monotone");

